{
  "name": "aguateria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @aguateria/api dev\" \"pnpm --filter @aguateria/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @aguateria/api db:generate",
    "db:migrate": "pnpm --filter @aguateria/api db:migrate",
    "db:seed": "pnpm --filter @aguateria/api db:seed",
    "db:studio": "pnpm --filter @aguateria/api db:studio",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/api/scripts/backup.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
