# ---------------------------------------------------------------------------
# Desarrollo local
# ---------------------------------------------------------------------------
# PostgreSQL local (servicio de Windows) o Supabase.
# En Supabase usar el POOLER, no la conexión directa:
#   - Producción/serverless: puerto 6543 (transaction pooler)
#   - Local:                  puerto 5432 (session pooler)
# DATABASE_URL=postgresql://postgres:CAMBIAR_PASSWORD@localhost:5432/aguateria
# DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_DE_32_CARACTERES
BETTER_AUTH_URL=http://localhost:3001

# API
PORT=3001
CORS_ORIGINS=http://localhost:5173

# Frontend (dejar vacío para usar el proxy de Vite o el rewrite de Vercel)
VITE_API_URL=

# ---------------------------------------------------------------------------
# Producción (Vercel) — configurar en Project Settings > Environment Variables
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require
# BETTER_AUTH_SECRET=<el mismo secreto largo, mínimo 32 caracteres>
# BETTER_AUTH_URL=https://<tu-proyecto>.vercel.app
# CORS_ORIGINS=https://<tu-proyecto>.vercel.app
# VITE_API_URL=            (vacío: el frontend llama a /api/v1 en el mismo dominio)
